{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "tsBuildInfoFile": "out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "vite.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.tsx",
    "src/remotes/remote-modules.d.ts"
  ],
  "references": [{ "path": "./tsconfig.app.json" }]
}
